# Token with repo + actions read access (falls back to `gh auth token` if unset)
GITHUB_TOKEN=
# Comma-separated repos shown on the home page
DASHBOARD_REPOS=owner/repo,owner/other-repo
# Optional
# DASHBOARD_MAX_ROWS=20
# DASHBOARD_TIMEZONE=Europe/Zurich
# GITHUB_API_URL=https://api.github.com
# DASHBOARD_HIDE_ENVS=copilot
